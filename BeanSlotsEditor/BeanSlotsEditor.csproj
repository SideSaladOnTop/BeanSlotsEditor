<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>BeanSlotsEditor</AssemblyName>
    <ApplicationIcon>BeanSlotsEditor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="categories.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="admin-item-list-public.json" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="BeanSlotsEditor.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
