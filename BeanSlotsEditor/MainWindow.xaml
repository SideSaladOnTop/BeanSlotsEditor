<Window x:Class="BeanSlotsEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BeanSlots Editor" Width="1250" Height="820" MinWidth="900" MinHeight="620" Background="#142030" Foreground="White" Closing="Window_Closing">
<DockPanel>
  <Border DockPanel.Dock="Top" Background="#202C3C" Padding="12"><StackPanel Orientation="Horizontal"><TextBlock Text="BEANSLOTS EDITOR" FontSize="22" FontWeight="Bold" Foreground="#56CBE1" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="Open config" Click="Open_Click"/><Button Content="Save" Click="Save_Click"/><Button Content="Save As" Click="SaveAs_Click"/><Button x:Name="UpdateRustHelpButton" Content="Check new items &amp; images" Click="UpdateRustHelp_Click"/><Button Content="Import item list" Click="Import_Click"/><Button Content="New defaults" Click="New_Click"/><TextBlock x:Name="PathLabel" VerticalAlignment="Center" Margin="15,0" Foreground="#C1CFDE" Text="No file loaded"/></StackPanel></Border>
  <Border DockPanel.Dock="Bottom" Padding="12" Background="#202C3C"><StackPanel Orientation="Horizontal"><TextBlock x:Name="StatusLabel" Text="Ready" Foreground="#C1CFDE"/><TextBlock x:Name="OddsLabel" Margin="24,0" Foreground="#66D5B1" FontWeight="Bold"/></StackPanel></Border>
  <TabControl x:Name="MainTabs" Margin="12" Background="#243145" Foreground="#102034">
    <TabItem Header="Prize editor"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0"><TextBlock DockPanel.Dock="Top" Text="ALL RUST ITEMS" Foreground="White" FontWeight="Bold" FontSize="16" Margin="4,4,4,8"/><TextBox DockPanel.Dock="Top" x:Name="ItemSearch" TextChanged="ItemSearch_Changed" ToolTip="Search shortname or display name"/><CheckBox x:Name="HideSelected" DockPanel.Dock="Top" Content="Hide items already in prizes" Checked="ItemSearch_Changed" Unchecked="ItemSearch_Changed"/><Button DockPanel.Dock="Bottom" Content="Add selected items →" Click="Add_Click"/><DataGrid x:Name="ItemsGrid" RowHeight="44" AutoGenerateColumns="False" SelectionMode="Extended" IsReadOnly="True"><DataGrid.Columns><DataGridTemplateColumn Header="Icon" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="38" Height="38" Stretch="Uniform"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Shortname" Binding="{Binding Shortname}" Width="1.4*"/></DataGrid.Columns></DataGrid></DockPanel>
      <DockPanel Grid.Column="2"><TextBlock DockPanel.Dock="Top" Text="SLOT PRIZES" Foreground="White" FontWeight="Bold" FontSize="16" Margin="4,4,4,8"/><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="200" x:Name="PrizeSearch" TextChanged="PrizeSearch_Changed" ToolTip="Filter selected prizes"/><Button Content="Remove selected" Click="Remove_Click"/><Button Content="Duplicate" Click="Duplicate_Click"/><Button Content="Apply batch changes" Click="Batch_Click"/></StackPanel>
      <Border DockPanel.Dock="Top" Background="#1A2B3B" BorderBrush="#40536A" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,10,0,10">
        <StackPanel>
          <TextBlock Text="TOTAL SPIN PROBABILITIES" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="Winning chance" Foreground="#B7EEDA"/><TextBlock x:Name="WinningChanceText" FontSize="24" FontWeight="Bold" Foreground="#66D5B1"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Non-winning chance" Foreground="#F1C6BC"/><TextBlock x:Name="LosingChanceText" FontSize="24" FontWeight="Bold" Foreground="#FFA38D"/></StackPanel>
          </Grid>
          <ProgressBar x:Name="WinningChanceBar" Minimum="0" Maximum="100" Value="0" Height="13" Foreground="#66D5B1" Background="#9F4D42" ToolTip="Green = winning probability; remaining portion = non-winning probability"/>
          <TextBlock x:Name="ChanceWarningText" Foreground="#FF9B7D" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <DataGrid x:Name="PrizesGrid" RowHeight="44" AutoGenerateColumns="False" SelectionMode="Extended" CellEditEnding="PrizesGrid_CellEditEnding"><DataGrid.Columns><DataGridTemplateColumn Header="Icon" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="38" Height="38" Stretch="Uniform"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Item" Binding="{Binding DisplayName}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="Shortname" Binding="{Binding Shortname, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Chance %" Binding="{Binding Chance, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Skin ID" Binding="{Binding Skin, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/></DataGrid.Columns></DataGrid></DockPanel>
    </Grid></TabItem>
    <TabItem Header="Economics &amp; spins"><ScrollViewer><StackPanel Margin="18" Width="440" HorizontalAlignment="Left"><TextBlock Text="SPIN SETTINGS" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock Text="Starting spins" Foreground="White"/><TextBox x:Name="StartingSpins"/><TextBlock Text="Maximum spins per click" Foreground="White"/><TextBox x:Name="MaxSpins"/><TextBlock Text="Animation frames" Foreground="White"/><TextBox x:Name="Frames"/><TextBlock Text="Animation interval (seconds)" Foreground="White"/><TextBox x:Name="FrameInterval"/><Separator Margin="0,15"/><CheckBox x:Name="EconomicsEnabled" Content="Allow purchasing spins using Economics"/><TextBlock Text="Spins per purchase" Foreground="White"/><TextBox x:Name="SpinsPerPurchase"/><TextBlock Text="Economics purchase cost" Foreground="White"/><TextBox x:Name="PurchaseCost"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Raidable Bases"><StackPanel Margin="22" Width="450" HorizontalAlignment="Left"><TextBlock Text="SPINS AWARDED PER COMPLETED RAID" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/><CheckBox x:Name="RewardAllRaiders" Content="Reward every participating raider"/><UniformGrid Columns="2" Rows="5"><TextBlock Text="Easy" Foreground="White" VerticalAlignment="Center"/><TextBox x:Name="Easy"/><TextBlock Text="Medium" Foreground="White" VerticalAlignment="Center"/><TextBox x:Name="Medium"/><TextBlock Text="Hard" Foreground="White" VerticalAlignment="Center"/><TextBox x:Name="Hard"/><TextBlock Text="Expert" Foreground="White" VerticalAlignment="Center"/><TextBox x:Name="Expert"/><TextBlock Text="Nightmare" Foreground="White" VerticalAlignment="Center"/><TextBox x:Name="Nightmare"/></UniformGrid></StackPanel></TabItem>
    <TabItem Header="Overlay button"><StackPanel Margin="22" Width="460" HorizontalAlignment="Left"><TextBlock Text="HUD SLOT BUTTON" Foreground="White" FontSize="19" FontWeight="Bold"/><CheckBox x:Name="OverlayEnabled" Content="Show overlay button"/><UniformGrid Columns="2"><TextBlock Text="Left (0–1)" Foreground="White"/><TextBox x:Name="OverlayLeft"/><TextBlock Text="Bottom (0–1)" Foreground="White"/><TextBox x:Name="OverlayBottom"/><TextBlock Text="Width (0–1)" Foreground="White"/><TextBox x:Name="OverlayWidth"/><TextBlock Text="Height (0–1)" Foreground="White"/><TextBox x:Name="OverlayHeight"/><TextBlock Text="Text" Foreground="White"/><TextBox x:Name="OverlayText"/><TextBlock Text="Font size" Foreground="White"/><TextBox x:Name="OverlayFont"/><TextBlock Text="Button RGBA" Foreground="White"/><TextBox x:Name="OverlayButtonColor"/><TextBlock Text="Text RGBA" Foreground="White"/><TextBox x:Name="OverlayTextColor"/></UniformGrid><TextBlock Text="Default left 0.438 places SLOTS just right of RAID." Margin="0,14" Foreground="#C5D3E0"/></StackPanel></TabItem>
  </TabControl>
</DockPanel>
</Window>
